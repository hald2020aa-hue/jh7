<?xml version='1.0' encoding='UTF-8'?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/library_layout" android:background="@drawable/v22_screen_background" android:layout_width="match_parent" android:clipChildren="false" android:layout_height="match_parent">

    <com.google.android.material.loadingindicator.LoadingIndicator android:id="@+id/progress" app:indicatorSize="75dp" android:layout_width="75dp" android:layout_height="75dp" android:layout_gravity="center"/>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipe_refresh" android:layout_width="match_parent" android:layout_height="match_parent">

        <FrameLayout android:id="@+id/recycler_layout" android:layout_width="match_parent" android:layout_height="match_parent">

            <eu.kanade.tachiyomi.ui.library.category.CategoryRecyclerView android:id="@+id/category_recycler" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="?actionBarSize" android:clipToPadding="false" android:visibility="invisible" android:paddingBottom="4dp" android:scrollbars="vertical"/>

            <View android:id="@+id/recycler_shadow" android:layout_width="match_parent" android:layout_height="20dp" android:alpha="0.25" android:background="@drawable/shape_gradient_top_shadow" android:translationY="12dp" app:layout_constraintBottom_toTopOf="@id/recycler" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent"/>

            <include layout="@layout/library_grid_recycler" android:id="@+id/library_grid_recycler"/>

            <View android:id="@+id/recycler_cover" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0" android:background="@drawable/bottom_sheet_rounded_background" android:backgroundTint="?attr/background"/>
        </FrameLayout>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.card.MaterialCardView android:id="@+id/header_card" app:strokeWidth="1dp" app:strokeColor="@color/v19_pink_soft" android:layout_marginTop="6dp" app:cardCornerRadius="15dp" app:cardBackgroundColor="@color/v19_surface" app:cardElevation="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center|top">

        <TextView android:id="@+id/header_title" style="?textAppearanceTitleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/v22_neon_chip" android:backgroundTint="@null" android:clickable="true" android:ellipsize="end" android:focusable="true" android:inputType="none" android:maxLines="1" android:textAlignment="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp" android:textColor="@color/v22_text" android:textSize="14sp" tools:text="Category"/>
    </com.google.android.material.card.MaterialCardView>


    <!-- V14: persistent actions appear immediately beneath the shared search app bar.
         The existing bottom sheet remains available for detailed filter selection. -->
    <FrameLayout android:id="@+id/library_top_actions" android:layout_width="match_parent" android:layout_height="145dp" android:layout_gravity="top" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:background="@drawable/v23_hero_banner" android:padding="3dp" android:elevation="8dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="3dp">

            <TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="@string/library" android:textSize="19sp" android:textStyle="bold" android:gravity="center_vertical|start" android:textColor="@color/v22_text" android:paddingStart="8dp"/><LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical">
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" app:cardCornerRadius="15dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/v19_surface" app:strokeColor="@color/v19_cyan_soft" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/library_stat_total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/v19_cyan" android:textSize="19sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/library" android:textColor="@color/v22_muted" android:textSize="9sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" app:cardCornerRadius="15dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/v19_surface" app:strokeColor="@color/v19_success" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/library_stat_completed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/v19_success" android:textSize="19sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/completed" android:textColor="@color/v22_muted" android:textSize="9sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" app:cardCornerRadius="15dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/v19_surface" app:strokeColor="@color/v19_pink_soft" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/library_stat_reading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/v19_pink" android:textSize="19sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reading" android:textColor="@color/v22_muted" android:textSize="9sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" app:cardCornerRadius="15dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/v19_surface" app:strokeColor="@color/v19_purple" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/library_stat_downloaded" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/v19_purple" android:textSize="19sp" android:textStyle="bold"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/downloaded" android:textColor="@color/v22_muted" android:textSize="9sp"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="56dp" android:fillViewport="true" android:scrollbars="none">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="4dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/library_top_categories" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="@string/library" android:textColor="@color/v22_text" app:icon="@drawable/v14_icon_library" app:iconTint="@color/v19_cyan" app:backgroundTint="@color/v22_raised_alt" app:strokeColor="@color/v22_stroke" app:strokeWidth="1dp" app:cornerRadius="18dp" android:layout_marginEnd="4dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/library_top_group" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="@string/group_library_by" android:textColor="@color/v22_text" app:icon="@drawable/v14_icon_group" app:iconTint="@color/v19_blue" app:backgroundTint="@color/v22_raised_alt" app:strokeColor="@color/v22_stroke" app:strokeWidth="1dp" app:cornerRadius="18dp" android:layout_marginEnd="4dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/library_top_display" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="@string/display_options" android:textColor="@color/v22_text" app:icon="@drawable/v14_icon_display" app:iconTint="@color/v19_pink" app:backgroundTint="@color/v22_raised_alt" app:strokeColor="@color/v22_stroke" app:strokeWidth="1dp" app:cornerRadius="18dp" android:layout_marginEnd="4dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/library_top_filter" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="@string/filter" android:textColor="@color/v22_text" app:icon="@drawable/v14_icon_filter" app:iconTint="@color/v19_cyan" app:backgroundTint="@color/v22_raised_alt" app:strokeColor="@color/v22_stroke" app:strokeWidth="1dp" app:cornerRadius="18dp" android:layout_marginEnd="4dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/library_top_expand" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="@string/expand_all_categories" android:textColor="@color/v22_text" app:icon="@drawable/ic_expand_more_24dp" app:iconTint="@color/v19_pink" app:backgroundTint="@color/v22_raised_alt" app:strokeColor="@color/v22_stroke" app:strokeWidth="1dp" app:cornerRadius="18dp" android:layout_marginEnd="4dp"/>
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </FrameLayout>

    <eu.kanade.tachiyomi.widget.EmptyView android:id="@+id/empty_view" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" android:background="@drawable/v22_surface_card" android:padding="16dp"/>

    <com.google.android.material.textview.MaterialTextView android:id="@+id/jumper_category_text" style="@style/FloatingTextView" android:layout_gravity="start|center" android:layout_marginBottom="8dp" android:alpha="0.0" android:gravity="center" app:layout_anchor="@id/category_hopper_frame" app:layout_anchorGravity="start|center" tools:alpha="1" tools:text="Category and a long one"/>

    <FrameLayout android:id="@+id/category_hopper_frame" android:layout_width="wrap_content" tools:layout_marginBottom="62dp" tools:layout_gravity="bottom|end" android:layout_height="wrap_content" android:clipToPadding="false" android:clipChildren="false" android:layout_gravity="top|center">

        <include layout="@layout/rounded_category_hopper" android:id="@+id/rounded_category_hopper"/>

    </FrameLayout>

    <eu.kanade.tachiyomi.ui.library.LibraryFastScroll android:id="@+id/fast_scroller" android:layout_width="match_parent" android:layout_height="match_parent" tools:visibility="gone" app:fastScrollerBubbleEnabled="true"/>

    <!-- Adding bottom sheet after main content -->
    <include layout="@layout/filter_bottom_sheet" android:id="@+id/filter_bottom_sheet"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
