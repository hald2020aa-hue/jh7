<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#6631E4FF" android:endColor="#88FF32CB" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#20163D" android:endColor="#101B32" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>
