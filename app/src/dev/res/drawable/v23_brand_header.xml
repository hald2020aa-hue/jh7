<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item><shape android:shape="rectangle"><gradient android:angle="0" android:startColor="#10112B" android:centerColor="#10112B" android:endColor="#10112B"/></shape></item>
  <item><bitmap android:src="@drawable/v23_brand_strip" android:gravity="fill" /></item>
  <item><shape android:shape="rectangle"><gradient android:angle="0" android:startColor="#040611" android:centerColor="#040611" android:endColor="#040611"/></shape></item>
  <!-- V24 crash guard: ReaderActivity toggles these IDs in onPrepareOptionsMenu.
       Transparent layers preserve the existing V23 header artwork. -->
  <item android:id="@+id/layer_full_width" android:drawable="@android:color/transparent" />
  <item android:id="@+id/layer_one_item" android:drawable="@android:color/transparent" />
</layer-list>
