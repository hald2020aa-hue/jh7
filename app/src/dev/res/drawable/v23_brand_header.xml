<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item><shape android:shape="rectangle"><gradient android:angle="0" android:startColor="#0B202C" android:centerColor="#0B202C" android:endColor="#0B202C"/></shape></item>
  <item><bitmap android:src="@drawable/v23_brand_strip" android:gravity="fill" /></item>
  <item><shape android:shape="rectangle"><gradient android:angle="0" android:startColor="#061018" android:centerColor="#061018" android:endColor="#061018"/></shape></item>
  <!-- V24 crash guard: ReaderActivity toggles these IDs in onPrepareOptionsMenu.
       Transparent layers preserve the existing V23 header artwork. -->
  <item android:id="@+id/layer_full_width" android:drawable="@android:color/transparent" />
  <item android:id="@+id/layer_one_item" android:drawable="@android:color/transparent" />
</layer-list>
